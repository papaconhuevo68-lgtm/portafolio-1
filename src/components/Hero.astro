---
import { EnvelopeClosedIcon, FileTextIcon, DownloadIcon } from "@radix-ui/react-icons";
import "@fontsource-variable/space-grotesk";
import LinkButton from "@astro/LinkButton.astro";
---

<section class="grid h-[92vh] place-content-center place-items-center gap-4 text-center">
  <div class="relative flex w-full justify-center items-center">
    <video
      src="/vannia1.mp4"
      autoplay
      loop
      muted
      playsinline
      class="size-44 md:size-56 rounded-full object-cover border-4 border-black transition duration-500 hover:scale-105"
      style="object-position: 78% 50%;"
    ></video>
  </div>
  <div class="flex flex-col">
    <h1 class="text-4xl font-bold md:text-4xl group cursor-crosshair font-space">
      Holii, me llamo <br />
      <span class="transition duration-300 ease-in-out group-hover:text-blue-600"
        >Vannia Angelica</span
      >
    </h1>
    <p class="my-4 font-varela">Desarrolladora de aplicaciones web. Santander, España.</p>
    <section class="mx-auto flex flex-col gap-3 sm:flex-row items-center justify-center">
      <LinkButton
        link="/cv.pdf"
        download="cv.pdf"
        variant="primary"
        text="Descargar mi CV"
        position="left"
        class="w-full sm:w-auto"
      >
        <DownloadIcon />
      </LinkButton>
      <LinkButton
        link="/cv.pdf"
        variant="secondary"
        text="Ver mi CV"
        position="left"
        class="w-full sm:w-auto"
      >
        <FileTextIcon />
      </LinkButton>
      <LinkButton
        link="https://wa.me/51927334920"
        variant="outline"
        text="Contactar"
        position="left"
        class="w-full sm:w-auto"
      >
        <EnvelopeClosedIcon />
      </LinkButton>
    </section>
  </div>
</section>
